<?xml version="1.0" encoding="UTF-8"?>
<File xmlns="http://www.esterel-technologies.com/ns/scade/6" xmlns:ed="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8" xmlns:kcg="http://www.esterel-technologies.com/ns/scade/pragmas/codegen/3">
	<declarations>
		<Operator kind="node" name="O">
			<inputs>
				<Variable name="i">
					<type>
						<NamedType>
							<type>
								<TypeRef name="bool"/>
							</type>
						</NamedType>
					</type>
					<pragmas>
						<ed:Variable oid="{O_i}"/>
					</pragmas>
				</Variable>
			</inputs>
			<outputs>
				<Variable name="o">
					<type>
						<NamedType>
							<type>
								<TypeRef name="bool"/>
							</type>
						</NamedType>
					</type>
					<pragmas>
						<ed:Variable oid="{O_o}"/>
					</pragmas>
				</Variable>
			</outputs>
			<data>
				<StateMachine name="SM1">
					<states>
						<State initial="true" name="State1">
							<locals>
								<Variable name="_L1">
									<type>
										<NamedType>
											<type>
												<TypeRef name="bool"/>
											</type>
										</NamedType>
									</type>
									<pragmas>
										<ed:Variable oid="{_L1}"/>
									</pragmas>
								</Variable>
							</locals>
							<data>
								<!-- o = _L1; -->
								<Equation>
									<lefts>
										<VariableRef name="o"/>
									</lefts>
									<right>
										<IdExpression>
											<path>
												<ConstVarRef name="_L1"/>
											</path>
										</IdExpression>
									</right>
									<pragmas>
										<ed:Equation oid="{o__}"/>
									</pragmas>
								</Equation>
								<!-- _L1 = i; -->
								<Equation>
									<lefts>
										<VariableRef name="_L1"/>
									</lefts>
									<right>
										<IdExpression>
											<path>
												<ConstVarRef name="i"/>
											</path>
										</IdExpression>
									</right>
									<pragmas>
										<ed:Equation oid="{_L1__}"/>
									</pragmas>
								</Equation>
							</data>
							<pragmas>
								<ed:State oid="{State1}"/>
							</pragmas>
						</State>
					</states>
					<pragmas>
						<ed:StateMachine oid="{SM1}"/>
					</pragmas>
				</StateMachine>
			</data>
			<pragmas>
				<ed:Operator oid="{O}" xmlns="http://www.esterel-technologies.com/ns/scade/pragmas/editor/8">
					<diagrams>
						<NetDiagram name="O" landscape="true" format="A4 (210 297)" oid="{O_O}">
							<presentationElements>
								<StateMachineGE presentable="{SM1}">
									<position>
										<Point x="1323" y="953"/>
									</position>
									<size>
										<Size width="5239" height="4128"/>
									</size>
								</StateMachineGE>
								<StateGE presentable="{State1}">
									<position>
										<Point x="1535" y="1191"/>
									</position>
									<size>
										<Size width="4710" height="3598"/>
									</size>
								</StateGE>
								<EquationGE presentable="{o__}">
									<position>
										<Point x="4974" y="2831"/>
									</position>
									<size>
										<Size width="318" height="503"/>
									</size>
								</EquationGE>
								<EquationGE presentable="{_L1__}">
									<position>
										<Point x="2381" y="2831"/>
									</position>
									<size>
										<Size width="265" height="503"/>
									</size>
								</EquationGE>
								<Edge leftVarIndex="1" rightExprIndex="1" srcEquation="{_L1__}" dstEquation="{o__}">
									<positions>
										<Point x="2646" y="3096"/>
										<Point x="3836" y="3096"/>
										<Point x="3836" y="3096"/>
										<Point x="5027" y="3096"/>
									</positions>
								</Edge>
							</presentationElements>
							<equationSets>
								<EquationSet name="EquationSet" oid="{EquationSet}">
									<presentable>{_L1__}</presentable>
									<presentable>{o__}</presentable>
								</EquationSet>
							</equationSets>
						</NetDiagram>
					</diagrams>
				</ed:Operator>
			</pragmas>
		</Operator>
	</declarations>
</File>
